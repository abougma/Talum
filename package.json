{
  "name": "taloom-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}' '*.{json,mjs,ts}' '.github/**/*.yml' README.md",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,css}' '*.{json,mjs,ts}' '.github/**/*.yml' README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "gsap": "^3.15.1",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "minimatch@^10.2.4": "11.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
